{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "cd web && npm ci && npm run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/main.py": {
      "includeFiles": "{data/*.json,data/*.geojson,data/metadata/thermal_sources.json,data/thermal/*.npy,docs/IMPLEMENTATION_STATUS.md,01_master_plan.md,03_phase_roadmap.md}",
      "excludeFiles": "{.venv/**,web/**,site/**,tests/**,data/runtime/**,docs/screenshots/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/main.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
