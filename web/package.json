{
  "name": "urban-heat-democratization-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run discovery:refresh && tsc --noEmit && vite build",
    "build:seo": "npm run discovery:refresh && node ../scripts/build-github-pages.mjs",
    "discovery:refresh": "node ../scripts/refresh-discovery.mjs",
    "discovery:check": "node ../scripts/refresh-discovery.mjs --check",
    "indexnow": "node ../scripts/submit-indexnow.mjs",
    "check:lockfile": "node scripts/check-lockfile-registry.mjs",
    "check:performance": "node scripts/check-performance-budget.mjs",
    "check:contrast": "node scripts/check-contrast-tokens.mjs",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:live": "E2E_LIVE_BACKEND=1 playwright test tests/e2e/fullscreen-map-live.spec.ts",
    "test:e2e:live:headed": "E2E_LIVE_BACKEND=1 playwright test --headed tests/e2e/fullscreen-map-live.spec.ts",
    "test:e2e:live:dev": "E2E_LIVE_BACKEND=1 playwright test --config playwright.dev.config.ts tests/e2e/fullscreen-map-live.spec.ts",
    "test:e2e:live:dev:headed": "E2E_LIVE_BACKEND=1 playwright test --headed --config playwright.dev.config.ts tests/e2e/fullscreen-map-live.spec.ts",
    "test:e2e:live:dev:stress": "E2E_LIVE_BACKEND=1 FULLSCREEN_TOGGLE_CYCLES=20 playwright test --config playwright.dev.config.ts tests/e2e/fullscreen-map-live.spec.ts"
  },
  "dependencies": {
    "@tanstack/react-form": "^1.2.6",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-router": "^1.72.1",
    "@tanstack/react-table": "^8.20.5",
    "katex": "^0.17.0",
    "maplibre-gl": "^5.24.0",
    "posthog-js": "^1.418.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-katex": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-katex": "^3.0.4",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
