# Same-origin API route used by the Vercel deployment and local Vite proxy.
VITE_API_BASE_URL=/api

# Public deployment URL, without a trailing slash.
VITE_SITE_URL=https://your-project.vercel.app

# Optional privacy-conscious product analytics. Leave unset to disable each provider.
# Enable only after reviewing the privacy policy and applicable consent requirements.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_CLARITY_PROJECT_ID=
# Required with the Clarity project ID. Obtain this Consent API v2 source ID
# from Microsoft before enabling Clarity in production.
VITE_CLARITY_CONSENT_SOURCE=
